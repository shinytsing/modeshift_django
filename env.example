# QAToolBox 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# Django 基础配置
DJANGO_SECRET_KEY=<replace-with-your-value>
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development

# 数据库配置 - 开发和生产环境都使用PostgreSQL
DB_NAME=qatoolbox_local
DB_USER=gaojie
DB_PASSWORD=<replace-with-your-value>
DB_HOST=localhost
DB_PORT=5432

# Redis配置 (可选，用于缓存和Celery)
REDIS_URL=redis://localhost:6379/0

# 第三方API配置
DEEPSEEK_API_KEY=<replace-with-your-value>
GOOGLE_API_KEY=<replace-with-your-value>
GOOGLE_CSE_ID=<replace-with-your-value>
OPENWEATHER_API_KEY=<replace-with-your-value>

# 百度OCR配置（用于作业批改）
# 获取方式：访问 https://cloud.baidu.com/ -> 开通"文字识别"服务 -> 创建应用获取API Key和Secret Key
BAIDU_OCR_API_KEY=<replace-with-your-value>
BAIDU_OCR_SECRET_KEY=<replace-with-your-value>

# Google OAuth配置
GOOGLE_OAUTH_CLIENT_ID=<replace-with-your-value>
GOOGLE_OAUTH_CLIENT_SECRET=<replace-with-your-value>

# 邮件配置 (生产环境)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=<replace-with-your-value>
DEFAULT_FROM_EMAIL=noreply@qatoolbox.com

# 安全配置 (生产环境)
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=

# 文件上传配置
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600  # 100MB
FILE_UPLOAD_MAX_MEMORY_SIZE=104857600  # 100MB
MAX_UPLOAD_SIZE=104857600  # 100MB

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# 开发工具配置
DEBUG_TOOLBAR=True
INTERNAL_IPS=127.0.0.1,localhost

# 缓存配置
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake

# 会话配置
SESSION_ENGINE=django.contrib.sessions.backends.db
SESSION_COOKIE_AGE=1209600  # 14天

# 静态文件配置
STATIC_URL=/static/
MEDIA_URL=/media/

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=True

# API限制配置
API_RATE_LIMIT_ANON=1000
API_RATE_LIMIT_USER=10000

# Celery配置
CELERY_BROKER_URL=django-db://
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=True

# 社交媒体API配置
XIAOHONGSHU_API_KEY=<replace-with-your-value>
DOUYIN_API_KEY=<replace-with-your-value>
NETEASE_API_KEY=<replace-with-your-value>
WEIBO_API_KEY=<replace-with-your-value>
BILIBILI_API_KEY=<replace-with-your-value>
ZHIHU_API_KEY=<replace-with-your-value>