# 多阶段构建 - 生产环境优化
FROM python:3.12-slim AS builder

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建虚拟环境
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 复制并安装Python依赖
COPY requirements.txt requirements.production.txt ./
RUN pip install --upgrade pip && \
    pip install -r requirements.production.txt

# 应用打包阶段。collectstatic 会把 src/static 复制到 staticfiles；
# 在中间阶段删掉源静态目录，避免大型音频在最终镜像中存两份。
FROM python:3.12-slim AS application

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制虚拟环境
COPY --from=builder /opt/venv /opt/venv

# 创建应用用户
RUN groupadd -r appuser && useradd -r -g appuser appuser

# 设置工作目录
WORKDIR /app

# 复制应用代码
COPY --chown=appuser:appuser . .

# WORKDIR 由 root 创建；先为运行用户创建可写目录。
RUN mkdir -p /app/staticfiles /app/media /app/logs && \
    chown appuser:appuser /app /app/staticfiles /app/media /app/logs

# 切换到应用用户
USER appuser

# 收集静态文件，然后移除已被收集的源文件副本
RUN python manage.py collectstatic --noinput && \
    rm -rf /app/src/static

# 最终生产阶段只携带一份静态资源。中间阶段的 COPY 层不会进入镜像，
# 因此不是用 whiteout “看起来删除”，而是实际减小传输大小。
FROM python:3.12-slim AS production

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app
COPY --from=application --chown=appuser:appuser /app /app
RUN chown appuser:appuser /app

USER appuser

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120", "--max-requests", "1000", "--max-requests-jitter", "100", "wsgi:application"]
