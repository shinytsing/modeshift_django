# 🚀 ModeShift Django 生产环境配置
# 专门为服务器 47.103.143.152 配置
# 域名: shenyiqing.xin

# ===== Django 基础配置 =====
DEBUG=False
DJANGO_SECRET_KEY=django-production-secret-key-change-me-123456789
DJANGO_SETTINGS_MODULE=config.settings.production

# ===== 数据库配置 =====
# PostgreSQL 数据库
DB_NAME=qatoolbox_production
DB_USER=qatoolbox
DB_PASSWORD=qatoolbox123
DB_HOST=localhost
DB_PORT=5432

# ===== Redis 缓存配置 =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis123

# ===== 第三方 API 配置 =====
# DeepSeek AI API
DEEPSEEK_API_KEY=sk-c4a84c8bbff341cbb3006ecaf84030fe

# Pixabay 图片 API
PIXABAY_API_KEY=your-pixabay-api-key-here

# 高德地图 API
AMAP_API_KEY=your-amap-api-key-here

# Google API
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-google-cse-id-here

# OpenWeather API
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ===== 邮件配置 =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@shenyiqing.xin

# ===== 安全配置 =====
# 允许的主机
ALLOWED_HOSTS=47.103.143.152,shenyiqing.xin,www.shenyiqing.xin,localhost,127.0.0.1,0.0.0.0

# SSL 配置
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# 会话安全
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ===== 静态文件和媒体文件 =====
STATIC_URL=/static/
STATIC_ROOT=/root/modeshift_django/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/root/modeshift_django/media

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=/var/log/modeshift_django.log

# ===== 缓存配置 =====
CACHE_BACKEND=redis
CACHE_LOCATION=redis://localhost:6379/1

# ===== 国际化配置 =====
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans
USE_I18N=True
USE_L10N=True
USE_TZ=True

# ===== 性能配置 =====
# Gunicorn 配置
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=2
GUNICORN_MAX_REQUESTS=1000

# ===== 监控配置 =====
# 健康检查
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_ENDPOINT=/health/

# 性能监控
PERFORMANCE_MONITORING=True
SENTRY_DSN=your-sentry-dsn-here

# ===== 备份配置 =====
BACKUP_ENABLED=True
BACKUP_DIR=/root/backups
BACKUP_RETENTION_DAYS=7

# ===== 通知配置 =====
NOTIFICATION_EMAIL=1009383129@qq.com
ALERT_EMAIL=1009383129@qq.com

# ===== 部署配置 =====
DEPLOY_TYPE=docker
DEPLOY_PATH=/root/modeshift_django
VENV_PATH=/root/modeshift_django/venv

# ===== 服务配置 =====
# Nginx 配置
NGINX_CONFIG_PATH=/etc/nginx/sites-available/modeshift_django
NGINX_ENABLED_PATH=/etc/nginx/sites-enabled/modeshift_django

# 服务端口
HTTP_PORT=80
HTTPS_PORT=443
DJANGO_PORT=8000

# ===== 开发工具配置 =====
# 调试工具
DEBUG_TOOLBAR=False
DEBUG_TOOLBAR_CONFIG=False

# 开发服务器
DEV_SERVER=False

# ===== 测试配置 =====
TEST_DATABASE=qatoolbox_test
TEST_REDIS_URL=redis://localhost:6379/2

# ===== 文档配置 =====
DOCS_ENABLED=True
API_DOCS_ENABLED=True

# ===== 其他配置 =====
# 文件上传限制
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB

# 会话配置
SESSION_COOKIE_AGE=1209600  # 2 weeks
SESSION_SAVE_EVERY_REQUEST=False

# 用户配置
AUTH_USER_MODEL=users.User
LOGIN_URL=/admin/login/
LOGIN_REDIRECT_URL=/admin/
LOGOUT_REDIRECT_URL=/

# ===== 环境特定配置 =====
# 生产环境标识
ENVIRONMENT=production
SERVER_NAME=shenyiqing.xin
SERVER_IP=47.103.143.152

# 域名配置
PRIMARY_DOMAIN=shenyiqing.xin
WWW_DOMAIN=www.shenyiqing.xin

# ===== 安全增强配置 =====
# 密码策略
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SYMBOLS=True

# 登录限制
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_TIMEOUT=300  # 5 minutes

# ===== 备份和恢复配置 =====
# 数据库备份
DB_BACKUP_ENABLED=True
DB_BACKUP_SCHEDULE="0 2 * * *"  # 每天凌晨2点
DB_BACKUP_RETENTION=7

# 文件备份
FILE_BACKUP_ENABLED=True
FILE_BACKUP_SCHEDULE="0 3 * * *"  # 每天凌晨3点
FILE_BACKUP_RETENTION=30

# ===== 监控和告警配置 =====
# 系统监控
SYSTEM_MONITORING=True
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90

# 应用监控
APP_MONITORING=True
RESPONSE_TIME_THRESHOLD=5  # seconds
ERROR_RATE_THRESHOLD=5  # percentage

# 告警配置
ALERT_ENABLED=True
ALERT_CHANNELS=email,webhook
ALERT_COOLDOWN=300  # 5 minutes

# ===== 性能优化配置 =====
# 数据库连接池
DB_CONN_MAX_AGE=600
DB_CONN_POOL_SIZE=20

# 缓存配置
CACHE_TTL=3600  # 1 hour
CACHE_MAX_ENTRIES=1000

# 静态文件缓存
STATIC_CACHE_TTL=86400  # 1 day
MEDIA_CACHE_TTL=3600  # 1 hour

# ===== 安全扫描配置 =====
# 安全扫描
SECURITY_SCAN_ENABLED=True
SECURITY_SCAN_SCHEDULE="0 4 * * 0"  # 每周日凌晨4点

# 漏洞扫描
VULNERABILITY_SCAN_ENABLED=True
VULNERABILITY_SCAN_SCHEDULE="0 5 * * 0"  # 每周日凌晨5点

# ===== 日志轮转配置 =====
# 日志轮转
LOG_ROTATION_ENABLED=True
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# ===== 健康检查配置 =====
# 健康检查端点
HEALTH_CHECK_ENDPOINTS=/,/health/,/admin/,/api/

# 健康检查间隔
HEALTH_CHECK_INTERVAL=30  # seconds
HEALTH_CHECK_TIMEOUT=10  # seconds

# 健康检查重试
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_RETRY_DELAY=5  # seconds
