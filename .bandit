# Bandit配置文件
# 跳过常见的误报和低风险问题

skips:
  - B110  # try_except_pass
  - B112  # try_except_continue
  - B311  # random
  - B404  # import_subprocess
  - B603  # subprocess_without_shell_equals_true
  - B607  # start_process_with_partial_path
  - B108  # hardcoded_tmp_directory
  - B305  # cipher_modes

exclude_dirs:
  - apps/tools/management/commands
  - __pycache__
  - .git
  - .tox
  - .eggs
  - "*.egg"
  - venv
  - env
  - .venv
  - .env

exclude:
  - apps/tools/legacy_views.py
  - apps/tools/guitar_training_views.py
  - apps/tools/ip_defense.py
  - apps/tools/async_task_manager.py
  - apps/tools/services/social_media/*
  - apps/tools/services/tarot_service.py
  - apps/tools/services/travel_data_service.py
  - apps/tools/services/triple_awakening.py
  - apps/tools/utils/music_api.py
  - apps/tools/views/basic_tools_views.py
  - apps/tools/views/food_randomizer_views.py
  - apps/tools/views/health_views.py
  - apps/tools/views/meetsomeone_views.py
  - apps/tools/views/tarot_views.py
  - apps/users/services/progressive_captcha_service.py

# 严重级别过滤 - 只报告高风险问题
severity: HIGH

# 置信度过滤 - 只报告高置信度问题
confidence: HIGH

# 上下文行数
context_lines: 3

# 聚合方式
aggregate: vuln